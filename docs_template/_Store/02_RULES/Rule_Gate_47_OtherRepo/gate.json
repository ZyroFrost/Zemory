{
  "hook": "hook.cjs",
  "match": {
    "tool": [
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "PowerShell"
    ]
  },
  "block": [
    {
      "note": "a writing zemory command aimed at another folder",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "zemory reindex --root \"../other-repo\""
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "the same through Push-Location",
      "files": {},
      "tool_name": "PowerShell",
      "tool_input": {
        "command": "Push-Location \"../other-repo\"; zemory sync --standard --apply"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    }
  ],
  "pass": [
    {
      "note": "a read-only zemory command elsewhere",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "cd \"../other-repo\" && zemory sync --check"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "a writing command in this repo",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "zemory reindex"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    }
  ]
}
