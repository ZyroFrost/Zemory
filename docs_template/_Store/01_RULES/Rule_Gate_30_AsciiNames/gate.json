{
  "hook": "hook.cjs",
  "match": {
    "tool": [
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "PowerShell"
    ]
  },
  "block": [
    {
      "note": "a new file with a non-ASCII name",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "báo-cáo.md",
        "content": "x\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "a Vietnamese identifier",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "src/a.ts",
        "content": "const ketQua = 1;\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "a new folder named in Vietnamese without marks",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "docs/agent/01_RULES/Rule_Core_80_DieuMotBatBien/RULE.md",
        "content": "x\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "a new file named in Vietnamese without marks",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "scripts/bao-cao-thang.py",
        "content": "x\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "a Vietnamese identifier the old syllable list missed",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "src/b.ts",
        "content": "const tongHopDoanhThu = 1;\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "mkdir of a Vietnamese name",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "mkdir tasks/nhan-vien"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    }
  ],
  "pass": [
    {
      "note": "a Vietnamese comment and a string are data",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "src/c.ts",
        "content": "// kết quả của phép đo\nconst label = \"ketQua\";\nconst result = 1;\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "editing a file that already has its name",
      "files": {
        "cũ.md": "x\n"
      },
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "cũ.md",
        "old_string": "x",
        "new_string": "y"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "English names made of short words that also fit a Vietnamese syllable",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "src/get-lang.ts",
        "content": "const mapPut = 1;\nconst getLang = 2;\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "an English part name",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "docs/agent/01_RULES/Rule_Core_80_OneNameDictionary/RULE.md",
        "content": "x\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    }
  ]
}
