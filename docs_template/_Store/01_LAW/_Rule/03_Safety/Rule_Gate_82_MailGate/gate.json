{
  "hook": "hook.cjs",
  "match": {
    "tool": [
      "Bash",
      "PowerShell"
    ]
  },
  "replaces_hooks": [
    "mail-gate.cjs"
  ],
  "block": [
    {
      "note": "the command calls a mail API itself",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "python -c \"import smtplib; smtplib.SMTP('x')\""
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    },
    {
      "note": "it runs a mail script by name",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "python scripts/02_mail.py --to someone"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    },
    {
      "note": "a launcher with a real-send argument",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "bin\\run_task.cmd live"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    },
    {
      "note": "a script whose own text sends mail",
      "files": {
        "tools/report_job.py": "import smtplib\nsmtplib.SMTP('x').send_message(m)\n"
      },
      "tool_name": "Bash",
      "tool_input": {
        "command": "python tools/report_job.py"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    },
    {
      "note": "an inline python -c that calls a mail API",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "python -c \"import smtplib; smtplib.SMTP('smtp.example.com').sendmail('a@example.com', ['b@example.com'], 'x')\""
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    }
  ],
  "pass": [
    {
      "note": "a plain command",
      "files": {
        "scripts/build_report.py": "print('ok')\n"
      },
      "tool_name": "Bash",
      "tool_input": {
        "command": "python scripts/build_report.py"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    },
    {
      "note": "a launcher test run without a send word",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "bin\\run_task.cmd test"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    },
    {
      "note": "an inline node -e script whose DATA names a send script runs nothing that sends",
      "files": {},
      "tool_name": "Bash",
      "tool_input": {
        "command": "node -e 'const cases = [{ tool_input: { command: \"python send.py\" } }]; console.log(cases.length)'"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    },
    {
      "note": "a | inside a quoted grep pattern is not a pipe: a reader-led line naming mail scripts runs nothing",
      "files": {
        "scripts/smtp_mail.py": "import smtplib\n"
      },
      "tool_name": "Bash",
      "tool_input": {
        "command": "ls scripts; grep -n \"__main__\\|argparse\\|def main\" scripts/smtp_mail.py | head; git show 41a493f --stat | head -20"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    },
    {
      "note": "an interpreter launcher (%*) is judged by the script it is handed, not by the usage note in its remarks",
      "files": {
        "bin/_python.cmd": "@echo off\r\nrem With arguments it also runs them: bin\\_python.cmd scripts\\x.py\r\n\"%PY%\" %*\r\n",
        "scripts/dw_access.py": "from smtp_mail import send\n",
        "tasks/X_Case/pipeline/08_check.py": "print('reads only')\n"
      },
      "tool_name": "Bash",
      "tool_input": {
        "command": "cmd /c \"bin\\_python.cmd tasks\\X_Case\\pipeline\\08_check.py\""
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "mail": ".allow-mail"
        }
      }
    }
  ]
}
