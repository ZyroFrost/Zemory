{
  "hook": "hook.cjs",
  "match": {
    "tool": [
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "PowerShell"
    ]
  },
  "block": [
    {
      "note": "a new open item in 04_TODO",
      "files": {
        "docs/agent/04_TODO.md": "# TODO\n- [ ] one\n- [ ] two\n"
      },
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "docs/agent/04_TODO.md",
        "old_string": "- [ ] two",
        "new_string": "- [ ] two\n- [ ] three"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "a request this rule's keywords catch",
      "prompt": "để sau rồi tính, ghi vào todo"
    }
  ],
  "pass": [
    {
      "note": "rewording an item",
      "files": {
        "docs/agent/04_TODO.md": "# TODO\n- [ ] one\n- [ ] two\n"
      },
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "docs/agent/04_TODO.md",
        "old_string": "- [ ] two",
        "new_string": "- [ ] two, reworded"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "closing an item",
      "files": {
        "docs/agent/04_TODO.md": "# TODO\n- [ ] one\n- [ ] two\n"
      },
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "docs/agent/04_TODO.md",
        "old_string": "- [ ] two",
        "new_string": "- [x] two"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "an unrelated request",
      "prompt": "chạy lại bộ test"
    }
  ],
  "prompt": {
    "kind": "Rule_38",
    "re": "\\b(de sau|ghi (vao )?todo|neo todo|note (lai )?de|lat nua|tinh sau|backlog|xu ly sau|lam sau|tam thoi)\\b",
    "text": "[zemory] Rule_Gate_38_TodoDoor: Noting something for later: an item enters 04_TODO only when approved in this session; what can be done now is done now."
  }
}
