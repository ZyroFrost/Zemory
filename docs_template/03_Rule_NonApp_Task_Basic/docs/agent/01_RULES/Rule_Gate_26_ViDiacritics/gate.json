{
  "hook": "hook.cjs",
  "match": {
    "tool": [
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "PowerShell"
    ]
  },
  "block": [
    {
      "note": "prose without diacritics in a .md file",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "notes.md",
        "content": "Viec nay khong duoc lam truoc khi kiem tra.\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "a code comment without diacritics",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "src/a.ts",
        "content": "// khong duoc goi ham nay\nconst x = 1;\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    }
  ],
  "pass": [
    {
      "note": "prose with diacritics",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "ok1.md",
        "content": "Việc này không được làm trước khi kiểm tra.\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "names other people chose, in backticks and quotes",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "ok3.md",
        "content": "Tên cột giữ nguyên: `Kich thuoc khu dat` và \"So luong nhap\".\n"
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "a line already in the file is not new",
      "files": {
        "old.md": "khong duoc lam\n"
      },
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "old.md",
        "old_string": "khong duoc lam",
        "new_string": "khong duoc lam\nDòng mới có dấu."
      },
      "policy": {
        "rules_file": "docs/agent/02_RULES.md",
        "todo_file": "docs/agent/05_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    }
  ]
}
