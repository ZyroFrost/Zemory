{
  "generator": "zemory",
  "comment": "ONE source for the layer-1 rules (irreversible actions the machine can check). guard.cjs (PreToolUse) and precommit-guard.cjs both read this file. Generated from the marker (.harness.json keys `protected`/`secretNames`/`secretAllow`/`allowedRoots`/`allowedSqlServers`/`repoGates`) — edit the marker, then run `zemory hook guard` to regenerate.",
  "protected_write": [
    "data",
    "share",
    "attic",
    "external",
    "docs/agent/01_CONSTITUTION.md",
    "docs/agent",
    "docs/plan",
    "AGENTS.md",
    "CLAUDE.md",
    "docs_template/_Store"
  ],
  "harness_write": [
    "docs/agent",
    "docs/plan",
    "AGENTS.md",
    "CLAUDE.md",
    "docs_template/_Store"
  ],
  "git_local": false,
  "fill_write": [
    "docs/agent/05_TODO.md",
    "docs/agent/06_CHANGES.md"
  ],
  "protected_write_reason": "a path declared `protected` in .harness.json — it belongs to the repo, the harness agent may not write into it",
  "harness_write_reason": "the harness docs (Rule_Gate_79_HarnessEdit) — creating, editing, deleting or moving anything in them needs the user's approval in this session; the agent never creates a rule, article, slot, skill or layer on its own",
  "secret_names": [
    ".env",
    ".env.*",
    "*.env",
    "*.pem",
    "*.ppk",
    "id_rsa*",
    "id_ed25519*",
    "*.key",
    "share.key",
    "*.enc",
    "global_memory*.db"
  ],
  "secret_allow": [
    ".env.example",
    "example.env",
    "sample.env"
  ],
  "secret_reason": "a secret must never enter a commit — there is NO flag to get past this (price already paid: a secret reached GitHub 2026-08-04)",
  "secret_values": {
    "patterns": [
      {
        "kind": "password",
        "re": "(?<![A-Za-z])(?:pass(?:word)?|pwd|secret|token|api[_-]?key|client[_-]?secret)(?![A-Za-z])[\"']?\\s*[:=]\\s*[\"']([^\"'\\s$<>{}%]{6,})[\"']",
        "flags": "i"
      },
      {
        "kind": "connection string",
        "re": "(?:^|[;\"'])\\s*(?:Password|Pwd)\\s*=\\s*([^;\"'\\s$<>{}%()]{4,})\\s*(?:;|$)",
        "flags": "i"
      },
      {
        "kind": "private key",
        "re": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
        "flags": ""
      },
      {
        "kind": "cloud access key",
        "re": "\\bAKIA[0-9A-Z]{16}\\b",
        "flags": ""
      }
    ],
    "placeholder": "^(?:changeme|change_me|password|secret|x{3,}|\\*+|your[_-].*|example.*|dummy.*|fake.*|placeholder.*|<.*>)$",
    "name": "^(?:[A-Z][A-Z0-9_]{2,}|[.#][a-z]+(?:-[a-z0-9]+)+|[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)+)$",
    "env": "environ|getenv|process\\.env|\\$\\{|%[A-Z_]+%|GetEnvironmentVariable|_env\\b",
    "skipPath": "(^|/)(vendors?|third[_-]?party|external|node_modules)/|(^|/)wwwroot/.*/lib/|\\.min\\.js$"
  },
  "key_read_block": [
    "*.pem",
    "*.ppk",
    "id_rsa*",
    "id_ed25519*",
    "*.key"
  ],
  "key_read_reason": "the contents of a key file must never be read, returned or logged; the key PATH is only a path",
  "allowed_roots": [],
  "allowed_sql_servers": [],
  "repo_gates": [],
  "read_first": {
    "required": [
      "docs/agent/05_TODO.md"
    ],
    "sections": [
      {
        "file": "docs/agent/02_RULES.md",
        "parts": [
          "core"
        ]
      },
      {
        "file": "docs/agent/01_CONSTITUTION.md",
        "parts": [
          "no-gate",
          "no-gate-articles",
          "heading:Mục đích"
        ]
      }
    ],
    "case_root": "tasks",
    "case_files": [
      "spec.md",
      "mail_form.md"
    ],
    "triggers": [
      {
        "when": "new_dir",
        "read": "docs/agent/03_STRUCTURE.md"
      },
      {
        "when": "path_prefix",
        "prefix": "frontend",
        "read": ".claude/skills/app-design/SKILL.md"
      },
      {
        "when": "cmd_re",
        "re": "(mail|smtp|email)[\\w.-]*\\.(py|ps1|js|mjs|cjs|cmd|bat)\\b",
        "read": ".claude/skills/write-style/SKILL.md"
      },
      {
        "when": "script_re",
        "re": "smtplib|send-mailmessage|smtpclient|sendmail\\(|send_message\\(|graph_mail|smtp_mail|/sendMail\\b",
        "read": ".claude/skills/write-style/SKILL.md"
      }
    ]
  },
  "rules_file": "docs/agent/02_RULES.md",
  "todo_file": "docs/agent/05_TODO.md",
  "rule_hooks": [
    {
      "file": "02-4_scratch-cap.cjs",
      "rule": "02-4"
    },
    {
      "file": "02-24_eol-keep.cjs",
      "rule": "02-24"
    },
    {
      "file": "02-30_ascii-names.cjs",
      "rule": "02-30"
    },
    {
      "file": "02-26_vi-diacritics.cjs",
      "rule": "02-26"
    },
    {
      "file": "02-29_code-english.cjs",
      "rule": "02-29"
    },
    {
      "file": "02-27_spec-voice.cjs",
      "rule": "02-27"
    },
    {
      "file": "02-1_second-machine.cjs",
      "rule": "02-1"
    },
    {
      "file": "02-2_reader-text.cjs",
      "rule": "02-2"
    },
    {
      "file": "02-13_test-red.cjs",
      "rule": "02-13"
    },
    {
      "file": "02-47_other-repo.cjs",
      "rule": "02-47"
    },
    {
      "file": "02-21_secret-value.cjs",
      "rule": "02-21"
    },
    {
      "file": "02-38_todo-door.cjs",
      "rule": "02-38"
    },
    {
      "file": "02-83_harness-from-store.cjs",
      "rule": "02-83"
    },
    {
      "file": "02-85_propose-checked.cjs",
      "rule": "02-85"
    }
  ],
  "rule_dirs": [],
  "sql": {
    "rule": "02-25",
    "rules_file": "docs/agent/02_RULES.md",
    "stores": [
      "backend/src/docs/store/queries.ts",
      "backend/src/memory/store/queries.ts"
    ],
    "code_ext": [
      ".ts",
      ".tsx",
      ".js",
      ".mjs",
      ".cjs"
    ],
    "exclude": [
      "backend/test/",
      "backend/scripts/",
      "test/",
      "tests/",
      "scripts/",
      "attic/",
      "external/",
      "docs_template/"
    ]
  },
  "outside_reason": "work stays INSIDE the project folder (Rule_Gate_44_RepoScope) — writing outside it, or making a SQL server write files or change its configuration, needs the user's word first",
  "hooks_dir": "docs/hooks",
  "flags_dir": "docs/hooks",
  "flags": {
    "push": ".allow-push",
    "docs_write": ".allow-docs-write",
    "git_add_all": ".allow-git-add-all",
    "delete": ".allow-delete",
    "discard": ".allow-discard",
    "overwrite": ".allow-overwrite",
    "outside": ".allow-outside",
    "todo": ".allow-todo",
    "mail": ".allow-mail"
  },
  "flags_comment": "A flag = the user approving ONE job. The guard lets it through, then STAMPS `ZEMORY-USED <command fingerprint> <timestamp>` into the flag file itself — it is NOT deleted at once. Within 90 seconds THAT SAME command may be retried (a PreToolUse hook cannot know whether the command really ran; another host layer blocking it would cost the flag for nothing). Asking for a DIFFERENT job, or going past 90 seconds, REVOKES the flag and it must be requested again. An agent may only create a flag after the user has said so explicitly in the session."
}
