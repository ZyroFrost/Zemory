      "files": {},
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "frontend/src/styles/old.css",
        "old_string": ".a { color: #111; }",
        "new_string": ".a { color: #111; }\n.b { color: var(--g-text); }"
