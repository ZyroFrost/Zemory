{
  "hook": "hook.cjs",
  "match": {
    "tool": [
      "Write",
      "Edit",
      "MultiEdit"
    ]
  },
  "block": [
    {
      "note": "an app styles its chosen row in the base blue",
      "files": {},
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "frontend/src/styles/app.css",
        "old_string": ".x {}",
        "new_string": ".x {}\ntr.on { background: rgba(124, 196, 255, .16); }"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "a new stylesheet writes white words",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "frontend/src/styles/card.css",
        "content": ".card-title { color: #fff; }\n"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "the next line of a shadow list carries a black",
      "files": {},
      "tool_name": "Edit",
      "tool_input": {
        "file_path": "frontend/shell/styles/a.css",
        "old_string": "a",
        "new_string": ".p { box-shadow: 0 1px 2px var(--x),\n    0 4px 8px rgba(0, 0, 0, .3); }"
      },
      "policy": {
        "rules_file": "docs/agent/01_LAW/_Rule",
        "todo_file": "docs/agent/04_TODO.md",
        "flags_dir": "docs/hooks",
        "flags": {
          "todo": ".allow-todo",
          "outside": ".allow-outside"
        }
      }
    },
    {
      "note": "an hsl colour",
      "files": {},
      "tool_name": "Write",
      "tool_input": {
        "file_path": "src/b.scss",
