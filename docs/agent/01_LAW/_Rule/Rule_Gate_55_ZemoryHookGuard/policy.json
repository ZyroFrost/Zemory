          "docs/agent/03_SKILLS/Skill_Doc_WriteStyle/Claude/doc-write-style/SKILL.md"
        ],
        "skill": "doc-write-style"
      },
      {
        "when": "script_re",
        "re": "smtplib|send-mailmessage|smtpclient|sendmail\\(|send_message\\(|graph_mail|smtp_mail|/sendMail\\b",
        "read": ".claude/skills/doc-write-style/SKILL.md",
        "alt": [
          "docs/agent/03_SKILLS/Skill_Doc_WriteStyle/Skill_Doc_WriteStyle.md",
          "docs/agent/03_SKILLS/Skill_Doc_WriteStyle/SKILL.md",
          "docs/agent/03_SKILLS/Skill_Doc_WriteStyle/Claude/doc-write-style/SKILL.md"
        ],
        "skill": "doc-write-style"
      }
    ]
  },
  "rules_file": "docs/agent/01_LAW/_Rule",
