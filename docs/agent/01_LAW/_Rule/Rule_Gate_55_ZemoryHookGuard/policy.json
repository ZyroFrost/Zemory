{
  "generator": "zemory",
  "comment": "ONE source for the layer-1 rules (irreversible actions the machine can check). guard.cjs (PreToolUse) and precommit-guard.cjs both read this file. Generated from the marker (.harness.json keys `protected`/`secretNames`/`secretAllow`/`allowedRoots`/`allowedSqlServers`/`repoGates`/`dockerPrune`) — edit the marker, then run `zemory hook guard` to regenerate.",
  "protected_write": [
    "data",
    "share",
    "attic",
    "external",
    "global-memory",
    "docs/agent/01_LAW/_Cons",
    "docs/agent",
    "docs/plan",
    "AGENTS.md",
    "CLAUDE.md",
    "docs_template/_Store"
  ],
  "harness_write": [
    "docs/agent",
    "docs/plan",
    "AGENTS.md",
    "CLAUDE.md",
    "docs_template/_Store"
  ],
  "git_local": false,
  "fill_write": [
    "docs/agent/04_TODO.md",
    "docs/agent/05_CHANGES.md",
    "docs/agent/01_LAW/_Cons/*/Cons.md",
    "docs/agent/03_SKILLS/Skill_Own_*"
  ],
  "protected_write_reason": "a path declared `protected` in .harness.json — it belongs to the repo, the harness agent may not write into it",
  "harness_write_reason": "the harness docs (Rule_Gate_79_HarnessEdit) — creating, editing, deleting or moving anything in them needs the user's approval in this session; the agent never creates a rule, article, slot, skill or layer on its own",
  "secret_names": [
    ".env",
    ".env.*",
    "*.env",
    "*.pem",
    "*.ppk",
    "id_rsa*",
    "id_ed25519*",
    "*.key",
    "share.key",
    "*.enc",
    "global_memory*.db"
  ],
  "secret_allow": [
    ".env.example",
    "example.env",
    "sample.env"
  ],
  "secret_reason": "a secret must never enter a commit — there is NO flag to get past this (price already paid: a secret reached GitHub 2026-08-04)",
  "secret_values": {
    "patterns": [
      {
        "kind": "password",
        "re": "(?<![A-Za-z])(?:pass(?:word)?|pwd|secret|token|api[_-]?key|client[_-]?secret)(?![A-Za-z])[\"']?\\s*[:=]\\s*[\"']([^\"'\\s$<>{}%]{6,})[\"']",
        "flags": "i"
      },
      {
        "kind": "connection string",
        "re": "(?:^|[;\"'])\\s*(?:Password|Pwd)\\s*=\\s*([^;\"'\\s$<>{}%()]{4,})\\s*(?:;|$)",
        "flags": "i"
      },
      {
        "kind": "private key",
        "re": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
        "flags": ""
      },
      {
        "kind": "cloud access key",
        "re": "\\bAKIA[0-9A-Z]{16}\\b",
        "flags": ""
      }
    ],
    "placeholder": "^(?:changeme|change_me|password|secret|x{3,}|\\*+|your[_-].*|example.*|dummy.*|fake.*|placeholder.*|<.*>)$",
    "name": "^(?:[A-Z][A-Z0-9_]{2,}|[.#][a-z]+(?:-[a-z0-9]+)+|[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)+)$",
    "env": "environ|getenv|process\\.env|\\$\\{|%[A-Z_]+%|GetEnvironmentVariable|_env\\b",
    "skipPath": "(^|/)(vendors?|third[_-]?party|external|node_modules)/|(^|/)wwwroot/.*/lib/|\\.min\\.js$"
  },
  "key_read_block": [
    "*.pem",
    "*.ppk",
    "id_rsa*",
    "id_ed25519*",
    "*.key"
  ],
  "key_read_reason": "the contents of a key file must never be read, returned or logged; the key PATH is only a path",
  "allowed_roots": [],
  "allowed_sql_servers": [],
  "repo_gates": [],
  "docker_prune": true,
  "read_first": {
    "required": [
      "docs/agent/04_TODO.md",
      "docs/agent/01_LAW/_Cons/01_Scope/Cons_Gate_09_Purpose/Cons.md",
      "docs/agent/01_LAW/_Cons/02_Data/Cons_Gate_10_ReadOnlySources/Cons.md",
      "docs/agent/01_LAW/_Cons/02_Data/Cons_Gate_11_WriteBoundary/Cons.md",
      "docs/agent/01_LAW/_Cons/02_Data/Cons_Gate_12_SourceOfTruth/Cons.md",
      "docs/agent/01_LAW/_Cons/03_System/Cons_Gate_13_Architecture/Cons.md",
      "docs/agent/01_LAW/_Cons/04_Security/Cons_Gate_14_Access/Cons.md",
      "docs/agent/01_LAW/_Cons/02_Data/Cons_Gate_15_DataLifecycle/Cons.md",
      "docs/agent/01_LAW/_Cons/03_System/Cons_Gate_16_Dependencies/Cons.md",
      "docs/agent/01_LAW/_Cons/Cons_Core_101_Repealed/Cons_Core_101_Repealed.md",
      "docs/agent/01_LAW/_Cons/Cons_Core_104_OneCapabilityOneSlot/Cons_Core_104_OneCapabilityOneSlot.md",
      "docs/agent/01_LAW/_Cons/Cons_Core_109_FailOpen/Cons_Core_109_FailOpen.md",
      "docs/agent/01_LAW/_Cons/Cons_Core_112_MeasureBeforeDefault/Cons_Core_112_MeasureBeforeDefault.md",
      "docs/agent/01_LAW/_Cons/Cons_Core_115_MemoryQualityFirst/Cons_Core_115_MemoryQualityFirst.md",
      "docs/agent/01_LAW/_Cons/Cons_Core_117_OneFunctionOneCommand/Cons_Core_117_OneFunctionOneCommand.md",
      "docs/agent/01_LAW/_Rule/Rule_Core_74_NoHsWorkForOthers/Rule_Core_74_NoHsWorkForOthers.md"
    ],
    "sections": [],
    "case_root": "tasks",
    "case_files": [
      "spec.md",
      "mail_form.md"
    ],
    "triggers": [
      {
        "when": "new_dir",
        "read": "docs/agent/02_STRUCTURE/INDEX.md"
      },
      {
        "when": "path_prefix",
        "prefix": "frontend",
        "read": ".claude/skills/app-base/SKILL.md",
        "alt": [
          "docs/agent/03_SKILLS/Skill_App_Base/Skill_App_Base.md",
          "docs/agent/03_SKILLS/Skill_App_Base/SKILL.md",
          "docs/agent/03_SKILLS/Skill_App_Base/Claude/app-base/SKILL.md"
